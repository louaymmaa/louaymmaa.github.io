---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.fullName} — ${site.role}`,
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Set the theme + arm reveal animations before paint (no flash). */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const dark =
            saved === 'dark' ||
            (!saved && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {}
        // Only hide content for the reveal effect if we can observe + restore it.
        if ('IntersectionObserver' in window) {
          document.documentElement.classList.add('js-reveal');
        }
      })();
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: site.fullName,
        jobTitle: site.role,
        email: `mailto:${site.email}`,
        url: site.url,
        sameAs: [site.socials.github, site.socials.linkedin],
      })}
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-fg"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* Reveal-on-scroll — progressive enhancement, content is visible without JS. */}
    <script is:inline>
      (() => {
        const els = document.querySelectorAll('.reveal');
        const revealAll = () =>
          els.forEach((el) => el.classList.add('is-visible'));
        if (!('IntersectionObserver' in window) || els.length === 0) {
          revealAll();
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        els.forEach((el) => io.observe(el));
        // Safety net: never leave content hidden.
        setTimeout(revealAll, 2500);
        window.addEventListener('load', () =>
          requestAnimationFrame(() => io.takeRecords()),
        );
      })();
    </script>
  </body>
</html>
