---
import Icon from './Icon.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-border/70 bg-surface/40">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-4 py-8 text-sm text-fg-muted sm:flex-row sm:px-6"
  >
    <p>© {year} {site.fullName}. Built with Astro &amp; Tailwind CSS.</p>
    <div class="flex items-center gap-3">
      <a
        href={site.socials.github}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-fg"
        aria-label="GitHub"
      >
        <Icon name="github" size={18} />
      </a>
      <a
        href={site.socials.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-fg"
        aria-label="LinkedIn"
      >
        <Icon name="linkedin" size={18} />
      </a>
      <a
        href={`mailto:${site.email}`}
        class="transition-colors hover:text-fg"
        aria-label="Email"
      >
        <Icon name="mail" size={18} />
      </a>
    </div>
  </div>
</footer>
