---
import Icon from './Icon.astro';
import { site } from '../data/site';

const links = [
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  class="sticky top-0 z-40 border-b border-border/70 bg-bg/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="font-semibold tracking-tight text-fg transition-colors hover:text-accent"
    >
      Louay<span class="text-accent">.</span>Asiri
    </a>

    <div class="flex items-center gap-1">
      <ul class="mr-2 hidden items-center gap-1 md:flex">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="rounded-lg px-3 py-2 text-sm text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={site.socials.github}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg p-2 text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg"
        aria-label="GitHub profile"
      >
        <Icon name="github" size={18} />
      </a>
      <a
        href={site.socials.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg p-2 text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg"
        aria-label="LinkedIn profile"
      >
        <Icon name="linkedin" size={18} />
      </a>

      <button
        id="theme-toggle"
        type="button"
        class="rounded-lg p-2 text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg"
        aria-label="Toggle colour theme"
      >
        <Icon name="sun" size={18} class="hidden dark:block" />
        <Icon name="moon" size={18} class="block dark:hidden" />
      </button>

      <button
        id="menu-toggle"
        type="button"
        class="rounded-lg p-2 text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    hidden
    class="border-t border-border/70 bg-bg px-4 pb-4 pt-2 md:hidden"
  >
    <ul class="flex flex-col gap-1">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="block rounded-lg px-3 py-2.5 text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg"
              data-menu-link
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById('theme-toggle');
    toggle?.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch (e) {}
    });

    const menuBtn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const setMenu = (open) => {
      if (!menu || !menuBtn) return;
      menu.hidden = !open;
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    menuBtn?.addEventListener('click', () =>
      setMenu(menu?.hidden ?? false),
    );
    menu
      ?.querySelectorAll('[data-menu-link]')
      .forEach((a) => a.addEventListener('click', () => setMenu(false)));
  })();
</script>
