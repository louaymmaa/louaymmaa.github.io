---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { experience, achievements } from '../data/experience';

const showDev = import.meta.env.DEV;
---

<Section id="experience" kicker="Experience" title="Where I've worked & what I've won">
  <ol class="relative space-y-8 border-l border-border pl-6">
    {
      experience.map((entry) => (
        <li class="reveal">
          <span
            class="absolute -left-[6.5px] mt-1.5 h-3 w-3 rounded-full border-2 border-accent bg-bg"
            aria-hidden="true"
          />
          <div class="flex flex-wrap items-baseline justify-between gap-x-3">
            <h3 class="font-semibold text-fg">
              {entry.role}
              <span class="font-normal text-fg-muted"> · {entry.org}</span>
            </h3>
            <span class="text-sm text-fg-muted">{entry.period}</span>
          </div>
          {
            (() => {
              const points = entry.points.filter(
                (p) => showDev || !p.startsWith('TODO'),
              );
              return points.length > 0 ? (
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-fg-muted marker:text-accent">
                  {points.map((p) => (
                    <li class={p.startsWith('TODO') ? 'text-amber-500' : ''}>
                      {p}
                    </li>
                  ))}
                </ul>
              ) : null;
            })()
          }
        </li>
      ))
    }
  </ol>

  <div class="mt-12 reveal">
    <h3 class="flex items-center gap-2 font-semibold text-fg">
      <Icon name="trophy" size={18} class="text-accent" />
      Achievements
    </h3>
    <ul class="mt-3 space-y-2 text-sm text-fg-muted">
      {
        achievements.map((a) => (
          <li class="flex gap-2">
            <Icon name="sparkle" size={16} class="mt-0.5 shrink-0 text-accent" />
            {a}
          </li>
        ))
      }
    </ul>
  </div>
</Section>
