---
interface Props {
  id: string;
  title: string;
  kicker?: string;
  class?: string;
}

const { id, title, kicker, class: className = '' } = Astro.props;
---

<section id={id} class={`mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20 ${className}`}>
  <div class="reveal">
    {
      kicker && (
        <p class="mb-2 text-sm font-medium uppercase tracking-widest text-accent">
          {kicker}
        </p>
      )
    }
    <h2 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">
      {title}
    </h2>
  </div>
  <div class="mt-8">
    <slot />
  </div>
</section>
