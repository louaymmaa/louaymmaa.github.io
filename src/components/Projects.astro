---
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';
import { featuredProjects, moreRepos } from '../data/projects';
import { site } from '../data/site';
---

<Section id="projects" kicker="Projects" title="Things I've built">
  <div class="grid gap-6 sm:grid-cols-2">
    {featuredProjects.map((project) => <ProjectCard project={project} />)}
  </div>

  {
    moreRepos.length > 0 && (
      <div class="reveal mt-8 rounded-xl border border-dashed border-border p-5">
        <p class="text-sm text-fg-muted">
          More work in progress on GitHub:
        </p>
        <ul class="mt-3 flex flex-wrap gap-3">
          {moreRepos.map((r) => (
            <li>
              <a
                href={r.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface px-3 py-1.5 text-sm text-fg transition-colors hover:border-accent/50 hover:text-accent"
              >
                <Icon name="github" size={15} />
                {r.name}
                <span class="text-fg-muted">· {r.language}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <p class="reveal mt-6 text-sm">
    <a
      href={site.socials.github}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 font-medium text-accent hover:underline"
    >
      See all repositories on GitHub
      <Icon name="arrow-right" size={16} />
    </a>
  </p>
</Section>
