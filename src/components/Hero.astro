---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section id="top" class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-60 [mask-image:radial-gradient(60%_50%_at_50%_0%,#000,transparent)]"
    aria-hidden="true"
  >
    <div
      class="absolute left-1/2 top-[-10rem] h-[24rem] w-[36rem] -translate-x-1/2 rounded-full bg-accent/20 blur-3xl"
    >
    </div>
  </div>

  <div
    class="mx-auto grid max-w-5xl gap-10 px-4 py-16 sm:px-6 sm:py-24 md:grid-cols-[1fr_auto] md:items-center"
  >
    <div class="reveal">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-sm text-fg-muted"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
        </span>
        {site.availability}
      </p>

      <h1
        class="mt-5 text-4xl font-extrabold tracking-tight text-fg sm:text-5xl"
      >
        {site.fullName}
      </h1>
      <p class="mt-4 max-w-xl text-lg text-fg-muted sm:text-xl">
        {site.tagline}
      </p>

      <p class="mt-3 flex items-center gap-2 text-sm text-fg-muted">
        <Icon name="map-pin" size={16} />
        {site.location}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 font-medium text-accent-fg transition-transform hover:-translate-y-0.5"
        >
          View projects
          <Icon name="arrow-right" size={18} />
        </a>
        <a
          href={site.cv}
          download
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-5 py-2.5 font-medium text-fg transition-colors hover:bg-surface-2"
        >
          <Icon name="download" size={18} />
          Download CV
        </a>
      </div>

      <div class="mt-6 flex items-center gap-4 text-fg-muted">
        <a
          href={site.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm transition-colors hover:text-fg"
        >
          <Icon name="github" size={18} /> GitHub
        </a>
        <a
          href={site.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm transition-colors hover:text-fg"
        >
          <Icon name="linkedin" size={18} /> LinkedIn
        </a>
      </div>
    </div>

    <div class="reveal justify-self-center md:justify-self-end">
      <div class="relative">
        <div
          class="absolute -inset-3 -z-10 rounded-full bg-gradient-to-br from-accent/30 to-transparent blur-xl"
          aria-hidden="true"
        >
        </div>
        <picture>
          <source srcset="/louay.webp" type="image/webp" />
          <img
            src="/louay.jpg"
            width="220"
            height="220"
            alt="Portrait of Louay Asiri"
            class="h-40 w-40 rounded-full border border-border object-cover shadow-xl sm:h-52 sm:w-52"
            fetchpriority="high"
          />
        </picture>
      </div>
    </div>
  </div>
</section>
