---
/**
 * Tiny inline-SVG icon set. Kept in one file so the site has no icon
 * dependency and every glyph is easy to see and tweak.
 */
type Name =
  | 'github'
  | 'linkedin'
  | 'mail'
  | 'download'
  | 'external'
  | 'arrow-right'
  | 'sun'
  | 'moon'
  | 'menu'
  | 'close'
  | 'sparkle'
  | 'trophy'
  | 'map-pin';

interface Props {
  name: Name;
  class?: string;
  size?: number;
}

const { name, class: className, size = 20 } = Astro.props;

