  mail: '<path d="M3 6.5A2.5 2.5 0 0 1 5.5 4h13A2.5 2.5 0 0 1 21 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5v-11Zm2.2-.3 6.8 5.1 6.8-5.1a.5.5 0 0 0-.3-.2H5.5a.5.5 0 0 0-.3.2Zm13.6 1.5-6.2 4.65a1 1 0 0 1-1.2 0L5 7.7v9.8a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5V7.7Z"/>',
