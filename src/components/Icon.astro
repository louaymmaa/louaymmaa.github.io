    '<path d="M12 2.5c.3 3.9 1.6 5.2 5.5 5.5-3.9.3-5.2 1.6-5.5 5.5-.3-3.9-1.6-5.2-5.5-5.5 3.9-.3 5.2-1.6 5.5-5.5ZM18.5 13c.2 2.2.9 2.9 3 3-2.1.2-2.8.9-3 3-.2-2.1-.9-2.8-3-3 2.1-.1 2.8-.8 3-3Z"/>',
