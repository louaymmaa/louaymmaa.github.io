---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Louay Asiri">
  <section
    class="mx-auto flex max-w-5xl flex-col items-center px-4 py-28 text-center sm:px-6"
  >
    <p class="text-6xl font-extrabold text-accent">404</p>
    <h1 class="mt-4 text-2xl font-bold text-fg">This page doesn&rsquo;t exist</h1>
    <p class="mt-2 text-fg-muted">
      The link may be broken, or the page may have moved.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 font-medium text-accent-fg"
    >
      Back to home
    </a>
  </section>
</Base>
